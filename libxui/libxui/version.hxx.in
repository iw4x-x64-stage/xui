#pragma once

// The numeric version format is AAAAABBBBBCCCCCDDDE where:
//
// AAAAA - major version number
// BBBBB - minor version number
// CCCCC - bugfix version number
// DDD   - alpha / beta (DDD + 500) version number
// E     - final (0) / snapshot (1)
//
// When DDDE is not 0, 1 is subtracted from AAAAABBBBBCCCCC. For example:
//
// Version      AAAAABBBBBCCCCCDDDE
//
// 0.1.0        0000000001000000000
// 0.1.2        0000000001000020000
// 1.2.3        0000100002000030000
// 2.2.0-a.1    0000200001999990010
// 3.0.0-b.2    0000299999999995020
// 2.2.0-a.1.z  0000200001999990011
//
#define LIBXUI_VERSION       $libxui.version.project_number$ULL
#define LIBXUI_VERSION_STR   "$libxui.version.project$"
#define LIBXUI_VERSION_ID    "$libxui.version.project_id$"
#define LIBXUI_VERSION_FULL  "$libxui.version$"

#define LIBXUI_VERSION_MAJOR $libxui.version.major$
#define LIBXUI_VERSION_MINOR $libxui.version.minor$
#define LIBXUI_VERSION_PATCH $libxui.version.patch$

#define LIBXUI_PRE_RELEASE   $libxui.version.pre_release$

#define LIBXUI_SNAPSHOT_SN   $libxui.version.snapshot_sn$ULL
#define LIBXUI_SNAPSHOT_ID   "$libxui.version.snapshot_id$"
